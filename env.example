# Copy to .env and fill ALL secrets, or use node scripts/init-local.mjs locally.
NODE_ENV=development
DB_NAME=crm_local
DB_USER=crm
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
CORS_ORIGINS=
# Production: NODE_ENV=production, APP_ORIGIN=https://crm.example.com,
# COOKIE_SECURE=true, TRUST_PROXY=1 behind the single trusted Nginx.
