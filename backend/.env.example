NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=softskills
DB_PASSWORD=replace-me
DB_NAME=softskills_v1
# At least 32 random characters; generate: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Production HTTPS behind a single trusted reverse proxy:
TRUST_PROXY=0
COOKIE_SECURE=false

# Extra exact origins separated by commas (no wildcard, paths, or trailing slash).
CORS_ORIGINS=
# lax for same-site; none only for cross-site HTTPS (Secure=true required).
COOKIE_SAME_SITE=lax
