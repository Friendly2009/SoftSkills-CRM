{
  "name": "softskills-crm-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test --test-timeout=180000 --test-concurrency=1 test/integration/*.test.ts",
    "openapi": "node --import tsx src/openapi.ts",
    "lint": "eslint src test",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "migrate:prod": "node dist/migrate.js",
    "test:e2e": "node --import tsx --test test/integration/readiness.test.ts",
    "dev:seed": "node --import tsx src/devSeed.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
